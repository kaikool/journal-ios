<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AppSecrets.plist.example
  HƯỚNG DẪN DÙNG CHO BỐ:
  1. Đổi tên file này thành "AppSecrets.plist" (bỏ chữ .example).
  2. Điền các API Key của Bố vào giữa các cặp thẻ <string></string>.
  3. Kéo file "AppSecrets.plist" vào project Xcode (chọn target TradeJournal).
  4. File này đã được thêm vào .gitignore nên Git VĨNH VIỄN KHÔNG BAO GIỜ đẩy file này lên mạng!
  5. Khi Bố build ra iPhone/iPad: Ứng dụng tự động nạp toàn bộ key, BỐ KHÔNG PHẢI GÕ MỘT CHỮ NÀO!
-->
<plist version="1.0">
<dict>
    <!-- 1. Google Gemini API Key (aistudio.google.com/app/apikey) -->
    <key>GEMINI_API_KEY</key>
    <string></string>

    <!-- 2. Groq Cloud API Key & Backup Key (console.groq.com/keys) -->
    <key>GROQ_API_KEY</key>
    <string></string>
    <key>GROQ_BACKUP_KEY</key>
    <string></string>

    <!-- 3. OpenRouter API Key (openrouter.ai/keys) -->
    <key>OPENROUTER_API_KEY</key>
    <string></string>

    <!-- 4. Supabase Database Project URL & Anon Key (supabase.com) -->
    <key>SUPABASE_URL</key>
    <string></string>
    <key>SUPABASE_ANON_KEY</key>
    <string></string>

    <!-- 5. OANDA v20 Access Token & Account ID (fxtrade.oanda.com) -->
    <key>OANDA_API_KEY</key>
    <string></string>
    <key>OANDA_ACCOUNT_ID</key>
    <string></string>

    <!-- 6. Exness REST API Keys (exness-api.com) -->
    <key>EXNESS_ACCOUNT_ID</key>
    <string></string>
    <key>EXNESS_API_KEY</key>
    <string></string>
    <key>EXNESS_PRIVATE_KEY</key>
    <string></string>
</dict>
</plist>
